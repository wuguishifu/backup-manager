{
  "name": "backup-manager-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @backup-manager/web dev",
    "build": "pnpm -r --filter '!backup-manager-workspace' build",
    "typecheck": "pnpm -r --filter '!backup-manager-workspace' typecheck",
    "lint": "pnpm -r --filter '!backup-manager-workspace' lint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,yaml,md}\" --ignore-path apps/web/.prettierignore"
  }
}
